<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.cresco</groupId>
        <artifactId>cresco-parent</artifactId>
        <version>1.3-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <repositories>
        <repository>
            <id>central-portal-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>


    <artifactId>agent</artifactId>
    <packaging>jar</packaging>

    <name>Cresco Agent</name>
    <description>Cresco Framework Core Agent</description>
    <url>https://github.com/CrescoEdge/agent</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:git://github.com/CrescoEdge/agent.git</connection>
    </scm>

    <properties>
        <!-- jdk, encoding, plugin versions inherited from cresco-parent -->
        <!-- Apache Felix Framework launcher (current latest). Bump in Phase 2 to refresh the framework. -->
        <felix.main.version>7.0.5</felix.main.version>
        <!-- Escape hatch for the embedded-bundle build guard (EmbeddedBundleCheck); never set it
             for a build that will be deployed. -->
        <cresco.skipBundleCheck>false</cresco.skipBundleCheck>
        <!-- The FIPS 140-3 crypto modules the agent carries, unmodified, in crypto/ (CryptoBoot): BC-FJA 2.1.x (CMVP
             #4943; 2.1.3 is a patched 2.1.2 under that certificate, with no open advisory) and its companions, and
             ACCP-FIPS (AWS-LC FIPS 3.0.0, CMVP #4816) for Linux x86_64 and aarch64. -->
        <bcfips.version>2.1.3</bcfips.version>
        <bcpkix-fips.version>2.1.13</bcpkix-fips.version>
        <bcutil-fips.version>2.1.8</bcutil-fips.version>
        <bctls-fips.version>2.1.25</bctls-fips.version>
        <accp-fips.version>2.5.0</accp-fips.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.apache.felix</groupId>
            <artifactId>org.apache.felix.main</artifactId>
            <version>${felix.main.version}</version>
        </dependency>

        <!-- commons-configuration2 replaces EOL commons-configuration 1.x (no security patches;
             pulled vulnerable commons-beanutils). v2 brings commons-lang3 + commons-text (both
             non-optional, bundled by the assembly). beanutils is optional and NOT pulled.
             commons-logging is left in: configuration2 uses JCL at runtime and this uber-jar has
             no other JCL provider (unlike the OSGi bundles, which get it from pax-logging). -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-configuration2</artifactId>
            <version>2.15.1</version>
        </dependency>

        <!-- Conscrypt (BoringSSL via JCE provider) to accelerate the ActiveMQ inter-node broker TLS
             on nio+ssl:32010, the cross-node data path. Installed as top JCE provider in
             AgentEngine.main only when cresco_ssl_provider=CONSCRYPT; inert otherwise. The uber
             jar bundles native libs for linux/osx x86_64 and aarch_64. 2.6-alpha5 is the first
             release carrying the osx/linux aarch_64 natives; 2.5.2 is x86_64 only. -->
        <dependency>
            <groupId>org.conscrypt</groupId>
            <artifactId>conscrypt-openjdk-uber</artifactId>
            <version>2.6-alpha5</version>
        </dependency>

        <!-- Bouncy Castle FIPS, to compile against only (provided: never inlined in the agent jar). At run time the
             unmodified module jars in crypto/ are put on the class path by CryptoBoot. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bc-fips</artifactId>
            <version>${bcfips.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-fips</artifactId>
            <version>${bcpkix-fips.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcutil-fips</artifactId>
            <version>${bcutil-fips.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bctls-fips</artifactId>
            <version>${bctls-fips.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- maven-compiler-plugin (release 21) inherited from cresco-parent -->

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>buildnumber-maven-plugin</artifactId>
                <!-- version inherited from cresco-parent pluginManagement -->
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>create</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <doCheck>false</doCheck>
                    <doUpdate>false</doUpdate>
                    <shortRevisionLength>5</shortRevisionLength>
                </configuration>
            </plugin>

            <!-- Reference jars for the SBOM (EmbeddedSbom, InlinedLibraries.Reference): libraries the embedded bundles
                 inline as bare classes, with no pom.properties and no version constant, are named by content: every
                 class byte-identical to the class at the same path in one of these Maven artifacts. Resolved from the
                 Maven repository like any dependency (so an offline build needs them in the local repository), copied
                 in repository layout, never packaged. When a bundle inlines another version (an OSHI or micrometer
                 upgrade), the SBOM lists it as of unknown version and the known-vulnerability gate fails the build:
                 add the version the bundle now inlines here (the error names the classes). Changes here need the
                 owner's review (CODEOWNERS), as sbom/ does. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <!-- The FIPS crypto modules, unmodified, into the agent jar's crypto/ (a FIPS module checks its own jar:
                         it is never unpacked into the agent or a bundle); CryptoBoot puts them on the class path at start,
                         each checked against the SHA-384 the gate records. The same jars go to sbom-reference, where the
                         SBOM reads their Maven coordinates (they carry no pom.properties). -->
                    <execution>
                        <id>crypto-modules</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <skip>false</skip>
                            <overWriteReleases>true</overWriteReleases>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.bouncycastle</groupId>
                                    <artifactId>bc-fips</artifactId>
                                    <version>${bcfips.version}</version>
                                    <outputDirectory>${project.build.outputDirectory}/crypto</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.bouncycastle</groupId>
                                    <artifactId>bcpkix-fips</artifactId>
                                    <version>${bcpkix-fips.version}</version>
                                    <outputDirectory>${project.build.outputDirectory}/crypto</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.bouncycastle</groupId>
                                    <artifactId>bcutil-fips</artifactId>
                                    <version>${bcutil-fips.version}</version>
                                    <outputDirectory>${project.build.outputDirectory}/crypto</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.bouncycastle</groupId>
                                    <artifactId>bctls-fips</artifactId>
                                    <version>${bctls-fips.version}</version>
                                    <outputDirectory>${project.build.outputDirectory}/crypto</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.cryptools</groupId>
                                    <artifactId>AmazonCorrettoCryptoProvider-FIPS</artifactId>
                                    <version>${accp-fips.version}</version>
                                    <classifier>linux-x86_64</classifier>
                                    <outputDirectory>${project.build.outputDirectory}/crypto</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.cryptools</groupId>
                                    <artifactId>AmazonCorrettoCryptoProvider-FIPS</artifactId>
                                    <version>${accp-fips.version}</version>
                                    <classifier>linux-aarch_64</classifier>
                                    <outputDirectory>${project.build.outputDirectory}/crypto</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.bouncycastle</groupId>
                                    <artifactId>bc-fips</artifactId>
                                    <version>${bcfips.version}</version>
                                    <outputDirectory>${project.build.directory}/sbom-reference/org/bouncycastle/bc-fips/${bcfips.version}</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.bouncycastle</groupId>
                                    <artifactId>bcpkix-fips</artifactId>
                                    <version>${bcpkix-fips.version}</version>
                                    <outputDirectory>${project.build.directory}/sbom-reference/org/bouncycastle/bcpkix-fips/${bcpkix-fips.version}</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.bouncycastle</groupId>
                                    <artifactId>bcutil-fips</artifactId>
                                    <version>${bcutil-fips.version}</version>
                                    <outputDirectory>${project.build.directory}/sbom-reference/org/bouncycastle/bcutil-fips/${bcutil-fips.version}</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.bouncycastle</groupId>
                                    <artifactId>bctls-fips</artifactId>
                                    <version>${bctls-fips.version}</version>
                                    <outputDirectory>${project.build.directory}/sbom-reference/org/bouncycastle/bctls-fips/${bctls-fips.version}</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.cryptools</groupId>
                                    <artifactId>AmazonCorrettoCryptoProvider-FIPS</artifactId>
                                    <version>${accp-fips.version}</version>
                                    <classifier>linux-x86_64</classifier>
                                    <outputDirectory>${project.build.directory}/sbom-reference/software/amazon/cryptools/AmazonCorrettoCryptoProvider-FIPS/${accp-fips.version}</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.cryptools</groupId>
                                    <artifactId>AmazonCorrettoCryptoProvider-FIPS</artifactId>
                                    <version>${accp-fips.version}</version>
                                    <classifier>linux-aarch_64</classifier>
                                    <outputDirectory>${project.build.directory}/sbom-reference/software/amazon/cryptools/AmazonCorrettoCryptoProvider-FIPS/${accp-fips.version}</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                    <execution>
                        <id>sbom-reference</id>
                        <!-- early, so the tests judge the embedded jars as the SBOM step will -->
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <!-- literally false: -Dmdep.skip=true does not skip what the SBOM needs -->
                            <skip>false</skip>
                            <!-- each in Maven repository layout (group/artifact/version/), where its coordinates are read -->
                            <overWriteReleases>true</overWriteReleases>
                            <artifactItems>
                                <!-- OSHI 7.x's platform classes: executor and sysinfo inline them (Private-Package oshi.*)
                                     beside their nested oshi-core jar -->
                                <artifactItem>
                                    <groupId>com.github.oshi</groupId>
                                    <artifactId>oshi-common</artifactId>
                                    <version>7.3.2</version>
                                    <outputDirectory>${project.build.directory}/sbom-reference/com/github/oshi/oshi-common/7.3.2</outputDirectory>
                                </artifactItem>
                                <!-- the copies of oshi-core's classes they inline as well -->
                                <artifactItem>
                                    <groupId>com.github.oshi</groupId>
                                    <artifactId>oshi-core</artifactId>
                                    <version>7.3.2</version>
                                    <outputDirectory>${project.build.directory}/sbom-reference/com/github/oshi/oshi-core/7.3.2</outputDirectory>
                                </artifactItem>
                                <!-- micrometer's pause detection: library inlines it -->
                                <artifactItem>
                                    <groupId>org.latencyutils</groupId>
                                    <artifactId>LatencyUtils</artifactId>
                                    <version>2.0.3</version>
                                    <outputDirectory>${project.build.directory}/sbom-reference/org/latencyutils/LatencyUtils/2.0.3</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Build guard (CrescoEdge/agent#3): every embedded jar under src/main/resources must be
                 an OSGi bundle (Bundle-SymbolicName in its manifest). A controller.jar built
                 without bundle:bundle installs as an empty legacy bundle and the agent parks
                 silently at startup, so fail the build here instead, naming the jar. Runs on the
                 copied resources (exactly what gets packaged) right after compile, before tests. -->
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>verify-embedded-bundles</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <!-- set in the POM, so -Dmaven.antrun.skip=true does not skip it; only the documented
                                 -Dcresco.skipBundleCheck=true does (testing only) -->
                            <skip>${cresco.skipBundleCheck}</skip>
                            <target>
                                <java classname="io.cresco.main.EmbeddedBundleCheck"
                                      classpath="${project.build.outputDirectory}"
                                      fork="true" failonerror="true">
                                    <arg value="${project.build.outputDirectory}"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                    <!-- Software bill of materials (CycloneDX 1.6, JSON): target/agent-<version>.cdx.json, on every
                         `mvn package`. Written by the build's own code (MavenSbom + EmbeddedSbom), with no plugin
                         beyond this one, so an offline build writes it too: the agent and its Maven runtime
                         dependencies (coordinates, SHA-256/384/512, licenses and edges from the resolved POMs),
                         every embedded bundle with its hashes, and the libraries each bundle carries (nested jars,
                         pom.properties, and classes inlined without either). Any failure fails the build with the
                         reason. Sign the release with scripts/sign-release.sh. -->
                    <execution>
                        <id>sbom</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <!-- literally false: a parameter set in the POM is not read from the maven.antrun.skip
                                 property, so -Dmaven.antrun.skip=true cannot skip the SBOM (it used to) -->
                            <skip>false</skip>
                            <target>
                                <java classname="io.cresco.main.EmbeddedSbom"
                                      classpath="${project.build.outputDirectory}"
                                      fork="true" failonerror="true">
                                    <arg value="--create"/>
                                    <arg value="${project.build.directory}/${project.artifactId}-${project.version}.cdx.json"/>
                                    <arg value="${project.build.outputDirectory}"/>
                                    <arg value="${project.groupId}:${project.artifactId}:${project.version}"/>
                                    <arg value="${project.basedir}/pom.xml"/>
                                    <arg value="${settings.localRepository}"/>
                                    <arg pathref="maven.runtime.classpath"/>
                                    <!-- the reference jars (sbom-reference, below): inlined classes byte-identical to theirs
                                         are those artifacts at those versions -->
                                    <arg value="${project.build.directory}/sbom-reference"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                    <!-- The known-vulnerable-component gate: a build step, not a unit test, so -DskipTests and
                         -Dmaven.test.skip=true do not skip it, and its skip is literally false, so -Dmaven.antrun.skip=true
                         does not either (it used to skip the SBOM and the gate). It reads the SBOM just written and fails
                         the build on a known-vulnerable component without a valid (dated, reviewed, at most 30-day)
                         waiver, or a component of unknown version without a valid (likewise dated, reviewed, expiring)
                         allowance (sbom/, KnownVulnerabilityGate). Changes to sbom/, the gate and this file need the
                         owner's review (CODEOWNERS). -->
                    <execution>
                        <id>known-vulnerability-gate</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>false</skip>
                            <target>
                                <java classname="io.cresco.main.KnownVulnerabilityGate"
                                      classpath="${project.build.outputDirectory}"
                                      fork="true" failonerror="true">
                                    <arg value="${project.build.directory}/${project.artifactId}-${project.version}.cdx.json"/>
                                    <arg value="${project.basedir}/sbom"/>
                                    <!-- the SBOM must be this build's (every embedded jar, with its SHA-384); on a pass the
                                         gate writes its marker here: marker.properties (the manifest's Cresco-Gate) and
                                         META-INF/cresco/{sbom.cdx.json,embedded.sha384}, which the assembly needs -->
                                    <arg value="${project.build.outputDirectory}"/>
                                    <arg value="${project.build.directory}/gate"/>
                                </java>
                                <!-- reached only when the gate passed (failonerror): its marker becomes Maven properties
                                     for the assembly's manifest (exportAntProperties) -->
                                <loadproperties srcFile="${project.build.directory}/gate/marker.properties"/>
                            </target>
                            <exportAntProperties>true</exportAntProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <!-- version inherited from cresco-parent pluginManagement -->
                <configuration>
                    <descriptors>
                        <descriptor>src/assemble/bin.xml</descriptor>
                    </descriptors>
                    <archive>
                        <manifest>
                            <mainClass>io.cresco.main.AgentEngine</mainClass>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                        </manifest>
                        <manifestEntries>
                            <!-- the known-vulnerability gate's marker, exported by the gate's execution only when it
                                 passed; scripts/sign-release.sh refuses a jar without a valid one -->
                            <Cresco-Gate>${cresco.gate.marker}</Cresco-Gate>
                            <Cresco-Gate-Files>${cresco.gate.files}</Cresco-Gate-Files>
                            <Cresco-Gate-Date>${cresco.gate.date}</Cresco-Gate-Date>
                            <!-- java -jar runs it before main: it appends the crypto modules to the class path (CryptoBoot) -->
                            <Launcher-Agent-Class>io.cresco.main.CryptoBoot</Launcher-Agent-Class>
                            <artifactId>cresco-agent</artifactId>
                            <Implementation-Version>${project.version}.${buildNumber}.${maven.build.timestamp}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <finalName>${project.artifactId}-${project.version}</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>

        <finalName>${project.artifactId}-${project.version}</finalName>
    </build>

</project>
